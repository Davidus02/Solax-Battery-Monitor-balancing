type: custom:html-template-card
ignore_line_breaks: true
content: |
  <div style="overflow-x:auto;">
    <table style="width:100%; min-width:900px; border-collapse:collapse; text-align:center; font-family:monospace; font-size:12px; white-space:nowrap;">
      
      <tr style="background:#303030; position:sticky; top:0; font-size:11px;">
        <th style="padding:6px 4px;">Pack</th>
        {% for c in range(1,19) %} <th style="padding:6px 2px;">{{c}}</th> {% endfor %}
        <th style="padding:6px 4px;">MIN</th>
        <th style="padding:6px 4px;">MAX</th>
        <th style="padding:6px 4px;">Δ</th>
        <th style="padding:6px 4px;">Pack[V]</th>
        <th style="padding:6px 4px;">SOC</th>
        <th style="padding:6px 4px;">Proud</th>
        <th style="padding:6px 4px;">Kap.</th>
      </tr>

      {% for pack in range(1,5) %}
      <tr>
        <td style="background:#404040; font-weight:bold; font-size:14px;">{{pack}}</td>
        
        {% for i in range(1,19) %}
          {% set id='%02d'|format(i) %}
          {% set v = states('sensor.solax_baterie_'~pack~'_clanek_'~id)|replace(',','.')|float(0) %}
          {% set mx = states('sensor.solax_baterie_'~pack~'_clanek_max_napeti')|float(0) %}
          {% set mn = states('sensor.solax_baterie_'~pack~'_clanek_min_napeti')|float(0) %}
          {% set bal = is_state('sensor.solax_baterie_'~pack~'_balancer_'~id, 'Aktivní') %}
          
          {% set bg='#1f1f1f' %} {% set fg='white' %}
          {% if bal %}
            {% set bg='#d8c27a' %} {% set fg='#111' %}
          {% elif v==mx and v>0 %}
            {% set bg='#9f5555' %}
          {% elif v==mn and v>0 %}
            {% set bg='#556b9f' %}
          {% endif %}
          
          <td style="background:{{bg}}; color:{{fg}}; border:1px solid #4f4f4f; padding:4px 2px;">
            {{ '%0.3f' | format(v) }}
          </td>
        {% endfor %}
        
        <td style="background:#4c5f8b; color:white; padding:4px;">{{ states('sensor.solax_baterie_'~pack~'_clanek_min_napeti') }}</td>
        <td style="background:#8b4c4c; color:white; padding:4px;">{{ states('sensor.solax_baterie_'~pack~'_clanek_max_napeti') }}</td>
        <td>{{ states('sensor.solax_baterie_'~pack~'_rozdil_clanku_delta') }} mV</td>
        <td>{{ states('sensor.solax_baterie_'~pack~'_celkove_napeti') }} V</td>
        <td>{{ states('sensor.solax_baterie_'~pack~'_soc') }} %</td>
        <td>{{ states('sensor.solax_baterie_'~pack~'_proud') }} A</td>
        <td>{{ states('sensor.solax_baterie_'~pack~'_kapacita') }} Ah</td>
      </tr>
      {% endfor %}

      <tr><td colspan="26" style="height:12px; background:#111; border:none;"></td></tr>

      <tr style="background:#303030; font-size:11px;">
        <th style="padding:6px 4px;">Pack</th>
        <th colspan="2">Tmin</th>
        <th colspan="2">Tmax</th>
        <th colspan="1">BMS</th>
        {% for t in range(1,8) %} <th>T{{t}}</th> {% endfor %}
        <th colspan="13"></th>
      </tr>

      {% for pack in range(1,5) %}
      <tr>
        <td style="background:#404040; font-weight:bold;">{{pack}}</td>
        <td colspan="2">{{ states('sensor.solax_baterie_'~pack~'_teplota_max') }} °C</td>
        <td colspan="2">{{ states('sensor.solax_baterie_'~pack~'_teplota_min') }} °C</td>
        {% for t in range(1,9) %}
          {% set id='%02d'|format(t) %}
          <td>{{ states('sensor.solax_baterie_'~pack~'_teplota_'~id) }}</td>
        {% endfor %}
        <td colspan="13"></td>
      </tr>
      {% endfor %}

    </table>
  </div>
cards: []
title: Balanc - notebook
