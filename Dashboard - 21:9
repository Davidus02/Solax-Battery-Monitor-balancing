type: custom:html-template-card
ignore_line_breaks: true
content: >

  <div style="overflow-x:auto;">

  <table style=" width:100%; min-width:2500px; border-collapse:collapse;
  text-align:center; font-family:monospace; font-size:17px;">

  <tr style=" background:#303030; position:sticky; top:0;">

  <th style="padding:12px;">Pack</th>

  {% for c in range(1,19) %} <th>{{c}}</th> {% endfor %}

  <th>MAX</th> <th>MIN</th> <th>Pack[V]</th> <th>SOC</th> <th>Proud</th>
  <th>Kap.</th> <th>Δ</th>

  </tr>

  {% for pack in range(1,5) %}

  <tr>

  <td style=" background:#404040; font-weight:bold; font-size:18px;">

  {{pack}}

  </td>

  {% for i in range(1,19) %}

  {% set id='%02d'|format(i) %}

  {% set v= states( 'sensor.solax_baterie_'~ pack~ '_clanek_'~ id)

  |replace(',','.') |float(0) %}

  {% set mx= states( 'sensor.solax_baterie_'~ pack~ '_clanek_max_napeti')

  |float(0) %}

  {% set mn= states( 'sensor.solax_baterie_'~ pack~ '_clanek_min_napeti')

  |float(0) %}

  {% set bal= is_state( 'sensor.solax_baterie_'~ pack~ '_balancer_'~ id,

  'Aktivní')

  %}

  {% set bg='#1f1f1f' %} {% set fg='white' %}

  {% if bal %}
      {% set bg='#d8c27a' %}
      {% set fg='#111' %}

  {% elif v==mx %}
      {% set bg='#9f5555' %}

  {% elif v==mn %}
      {% set bg='#556b9f' %}

  {% endif %}

  <td style=" background:{{bg}}; color:{{fg}}; border:1px solid #4f4f4f;
  padding:11px;">

  {{

  '%0.3f' | format(

  states( 'sensor.solax_baterie_'~ pack~ '_clanek_'~ id)

  |replace(',','.') |float(0)

  )

  }}

  </td>

  {% endfor %}

  <td style=" background:#8b4c4c; color:white;">

  {{ states( 'sensor.solax_baterie_'~ pack~ '_clanek_max_napeti')

  }}

  </td>

  <td style=" background:#4c5f8b; color:white;">

  {{ states( 'sensor.solax_baterie_'~ pack~ '_clanek_min_napeti')

  }}

  </td>

  <td> {{ states( 'sensor.solax_baterie_'~ pack~ '_celkove_napeti') }} </td>

  <td> {{ states( 'sensor.solax_baterie_'~ pack~ '_soc') }}% </td>

  <td> {{ states( 'sensor.solax_baterie_'~ pack~ '_proud') }} </td>

  <td> {{ states( 'sensor.solax_baterie_'~ pack~ '_kapacita') }} </td>

  <td> {{ states( 'sensor.solax_baterie_'~ pack~ '_rozdil_clanku_delta') }}
  </td>

  </tr>

  {% endfor %}


  <tr> <td colspan="27" style=" height:16px; background:#111; border:none;">
  </td> </tr>


  <tr style="background:#303030">

  <th>Pack</th>

  <th colspan="3">Tmin</th> <th colspan="3">Tmax</th>

  <th>T1</th> <th>T2</th> <th>T3</th> <th>T4</th>

  <th>T5</th> <th>T6</th> <th>T7</th> <th>T8</th>

  <th colspan="12"></th>

  </tr>


  {% for pack in range(1,5) %}

  <tr>

  <td style=" background:#404040; font-weight:bold;">

  {{pack}}

  </td>

  <td colspan="3"> {{ states( 'sensor.solax_baterie_'~ pack~ '_teplota_min') }}
  °C </td>

  <td colspan="3"> {{ states( 'sensor.solax_baterie_'~ pack~ '_teplota_max') }}
  °C </td>

  {% for t in range(1,9) %}

  {% set id='%02d'|format(t) %}

  <td>

  {{ states( 'sensor.solax_baterie_'~ pack~ '_teplota_'~ id)

  }}

  </td>

  {% endfor %}

  <td colspan="12"></td>

  </tr>

  {% endfor %}

  </table>

  </div>
cards: []
title: "Balanc PC "
